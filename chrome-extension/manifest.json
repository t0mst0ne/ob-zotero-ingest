{
  "manifest_version": 3,
  "name": "OB–Zotero Academic Ingestion",
  "version": "1.0.0",
  "description": "一鍵將學術論文（PMC, Nature, Lancet, Wiley, Springer 等）擷取為 Obsidian 結構化正文並對齊 Zotero 書目",
  "key": "",
  "permissions": [
    "sidePanel",
    "nativeMessaging",
    "activeTab",
    "scripting",
    "storage",
    "clipboardRead",
    "cookies",
    "downloads"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "開啟 OB–Zotero 入庫側欄",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
